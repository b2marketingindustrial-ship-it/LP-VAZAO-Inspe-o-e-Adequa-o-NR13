---
/**
 * VARIANTE LOCAL (LP Vazão, 09/11/2026): logo da Vazão acima do eyebrow nas seções,
 * mantido da LP anterior por decisão da B2 (docs/BRIEFING.md). Fora do padrão B2.
 *
 * Sobre fundo claro o logo entra direto; sobre navy entra numa placa branca, a mesma
 * linguagem da placa do header, para o vermelho e o azul do logo não sumirem no fundo.
 */
import { Image } from 'astro:assets'
import logo from '@assets/LOGO.png'

interface Props {
  tone?: 'light' | 'dark'
  class?: string
}

const { tone = 'light', class: className = '' } = Astro.props
---

<span
  class:list={[
    'mb-4 flex w-fit items-center',
    tone === 'dark' && 'rounded-lg bg-neutral-light px-2.5 py-1.5',
    className,
  ]}
>
  <Image
    src={logo}
    alt=""
    width={230}
    format="webp"
    loading="lazy"
    decoding="async"
    class="h-7 w-auto sm:h-8"
  />
</span>
