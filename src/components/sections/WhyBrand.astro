---
/**
 * VARIANTE LOCAL (LP Vazão, 09/11/2026) — o miolo voltou ao layout ORIGINAL da LP anterior.
 * Slot `diferenciais` da biblioteca B2 (nome, id, dados e CTA exigidos pelo manifesto), com
 * o markup original: cabeçalho, foto que se dissolve e 5 cards brancos. Estilo em
 * src/styles/original.css (escopo `.vz`). `npm run compose` sobrescreve este arquivo: não
 * recomponha sem guardar esta versão.
 *
 * Diferenças do original: sem pessoa recortada (o original não tinha) e com um botão no fim
 * (o manifesto exige o CTA `diferenciais-cta`).
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import type { SectionProps } from '@lib/layout'
import { why } from '@data/sections/diferenciais'
import { ctaMiolo } from '@data/miolo'
import logo from '@assets/LOGO.png'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const parts = why.title.split('*')
---

<Section
  id="diferenciais"
  tone={tone}
  rhythm={rhythm}
  container={false}
  class="vz section dif-section"
  aria-labelledby="diferenciais-title"
>
  <svg
    class="dif-lines"
    viewBox="0 0 1440 800"
    preserveAspectRatio="none"
    aria-hidden="true"
    fill="none"
    stroke="#c9daf1"
    stroke-width="1"
  >
    <path d="M-40 120C180 60 260 260 520 240" opacity=".7"></path>
    <path d="M-40 160C190 100 270 300 540 280" opacity=".55"></path>
    <path d="M-40 200C200 140 280 340 560 320" opacity=".4"></path>
    <path d="M-40 240C210 180 290 380 580 360" opacity=".3"></path>
    <path d="M1480 60C1260 110 1240 300 980 330" opacity=".7"></path>
    <path d="M1480 100C1270 150 1250 340 1000 370" opacity=".55"></path>
    <path d="M1480 140C1280 190 1260 380 1020 410" opacity=".4"></path>
    <path d="M1480 180C1290 230 1270 420 1040 450" opacity=".3"></path>
  </svg>
  <Image
    class="sec-photo"
    src={why.scene.src}
    alt=""
    aria-hidden="true"
    width={1000}
    format="webp"
    loading="lazy"
    decoding="async"
  />
  <div class="wrap">
    <div class="dif-head reveal">
      <Image class="sec-logo" src={logo} alt="" width={230} loading="lazy" decoding="async" />
      <span class="eyebrow">{why.eyebrow}</span>
      <h2 id="diferenciais-title">{parts.map((t, i) => (i % 2 ? <em>{t}</em> : t))}</h2>
      <p>{why.text}</p>
    </div>

    <div class="benefits">
      {why.reasons.map((r, i) => (
        <article class:list={['benefit reveal', i ? `d${Math.min(i, 3)}` : false]}>
          <div class="benefit-icon" aria-hidden="true">
            <svg class="ico">
              <use href={`#i-${r.glyph}`} />
            </svg>
          </div>
          <h3>{r.title}</h3>
          <p>{r.description}</p>
        </article>
      ))}
    </div>

    <div class="cta-row">
      <button type="button" class="btn btn-slave-whats" data-cta="diferenciais-cta">
        {ctaMiolo}
        <svg class="ico" aria-hidden="true">
          <use href="#i-arrow" />
        </svg>
      </button>
    </div>
  </div>
</Section>
